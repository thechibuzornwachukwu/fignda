#!/bin/sh
# Local CI. GitHub Actions is off for this repo, so these run on every `git push`, in each app.
# Same checks the workflow had: secrets, lint, types, unit tests, dependency audit.
# The database security suite needs Docker; run it yourself with `npm run test:db` after DB changes.
echo "Checking before push. This takes a few minutes."
for app in puzzles detective; do
  [ -d "$app" ] || continue
  echo "== $app"
  (cd "$app" && npm run verify) || { echo; echo "Push stopped in $app. Fix the problem above, then push again."; exit 1; }
done
