{
  "name": "lantern-row",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "supabase start --ignore-health-check -x studio,postgres-meta,logflare,vector,imgproxy,storage-api,edge-runtime,realtime,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "prepare": "git config core.hooksPath ../.githooks",
    "check:secrets": "node scripts/check-secrets.mjs --all && node scripts/check-secrets.mjs --history",
    "verify": "node scripts/check-secrets.mjs --all && npm run lint && npm run typecheck && npm test && npm audit --audit-level=high",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8788",
    "deploy:site": "node scripts/deploy-site.mjs",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "pets:render": "tsx scripts/render-pets.ts",
    "flow:render": "node scripts/render-flow.mjs",
    "street:render": "tsx scripts/render-street.ts"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
